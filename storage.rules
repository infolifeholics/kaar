rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'info.lifeholics@gmail.com';
    }
    
    // Product images: public can view/read, only authorized admin can upload, edit, or delete
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
